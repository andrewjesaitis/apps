# Public client config for the "suggest values" feature. Copy to .env.local
# for local dev. For the deployed site, set these as repository Variables
# (Settings → Secrets and variables → Actions → Variables); the deploy-pedals.yml
# build step forwards them. Both are public by design (a site key + public URL).
VITE_SUGGEST_URL=
VITE_TURNSTILE_SITE_KEY=
